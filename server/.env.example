# Copy to .env.local (dev) or .env.prod (prod) and fill in. Never commit the real files.
NODE_ENV=development
PORT=8000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
SECRET_KEY=<at least 32 random characters>
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional
# REDIS_PASSWORD=
# CORS_ORIGIN=*
# METRICS_PORT=9090

# Password-reset email via Bird (https://bird.com)
BIRD_API_KEY=<bird api key>
EMAIL_FROM=onboarding@messagebird.dev
# Frontend base URL used to build the reset link
APP_URL=http://localhost:4000
